{
  "manifest_version": 3,
  "name": "Focus Alarm",
  "version": "0.3.0",
  "description": "Detects doomscrolling/distraction and requires solving a short challenge to dismiss the alarm. Local-first, no backend.",
  "permissions": [
    "storage",
    "alarms",
    "idle",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Focus Alarm",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "minimum_chrome_version": "116",
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}