{
  "manifest_version": 3,
  "name": "Focus Alarm",
  "version": "0.2.0",
  "description": "Detects doomscrolling/distraction and requires solving a short challenge to dismiss the alarm. Local-first, no backend.",
  "permissions": ["storage", "alarms", "tabs", "idle", "offscreen"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Focus Alarm"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-script.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
